+    // CORRENT PATCH: runtime per-torrent speed limits.
+    /// Change this torrent's speed limits while it runs. Returns false if it isn't live; the
+    /// limits configured when the torrent was added apply again after a pause/resume, so callers
+    /// re-apply theirs.
+    pub fn set_ratelimits(&self, limits: LimitsConfig) -> bool {
+        match self.live() {
+            Some(live) => {
+                live.ratelimits.set_download_bps(limits.download_bps);
+                live.ratelimits.set_upload_bps(limits.upload_bps);
+                true
+            }
+            None => false,
+        }
+    }
+
+    // CORRENT PATCH: runtime per-torrent speed limits.
+    /// The limits in effect while live.
+    pub fn ratelimits(&self) -> Option<LimitsConfig> {
+        self.live().map(|l| l.ratelimits.get_config())
+    }
