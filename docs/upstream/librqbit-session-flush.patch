+
+impl SessionFile {
+    // CORRENT PATCH (F16): `update_metadata` calls coalesce here. A burst (pause all) costs a
+    // write or two instead of one each, so at most the last `COALESCE` of them can be lost in a
+    // crash; Corrent's own records put a lost pause back (`Actor::enforce_pauses`).
+    async fn run_flusher(self: Arc<Self>) {
+        loop {
+            self.wake.notified().await;
+            tokio::time::sleep(COALESCE).await;
+            let db_content = self.db_content.write().await;
+            if self.stopped.load(Ordering::SeqCst) {
+                return;
+            }
+            if self.dirty.swap(false, Ordering::SeqCst)
+                && let Err(e) = self.write(&db_content).await
+            {
+                warn!(error=?e, "error writing session persistence; retrying");
+                self.dirty.store(true, Ordering::SeqCst);
+                self.wake.notify_one();
+                drop(db_content);
+                tokio::time::sleep(RETRY_AFTER).await;
+            }
+        }
+    }
+
+    // The only write of session.json. Every update so far is in it, whoever asked for it.
+    async fn flush(&self) -> anyhow::Result<()> {
+        // we don't need the write lock technically, but we need to stop concurrent modifications
+        let db_content = self.db_content.write().await;
+        self.dirty.store(false, Ordering::SeqCst);
+        let written = self.write(&db_content).await;
+        if written.is_err() {
+            self.dirty.store(true, Ordering::SeqCst);
+        }
+        written
+    }
