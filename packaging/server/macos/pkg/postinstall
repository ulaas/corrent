#!/bin/sh
# Corrent Server pkg: install the launchd agent for the user who is logged in at the console and
# start it. The server runs as that user (it reads their media); its data lives in
# ~/Library/Application Support/Corrent Server. Other users: see /usr/local/share/corrent-server/README.md.
label=io.github.ulaas.correntd
template=/usr/local/share/corrent-server/$label.plist
user=$(stat -f%Su /dev/console)
case "$user" in root|loginwindow|_mbsetupuser|"")
  echo "no user is logged in; install the agent later with: /usr/local/share/corrent-server/enable-agent.sh"
  exit 0 ;;
esac
uid=$(id -u "$user") || exit 0
home=$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')
[ -d "$home" ] || exit 0
agents="$home/Library/LaunchAgents"
sudo -u "$user" mkdir -p "$agents"
sudo -u "$user" cp "$template" "$agents/$label.plist"
launchctl bootout "gui/$uid/$label" 2>/dev/null || true
launchctl bootstrap "gui/$uid" "$agents/$label.plist" || echo "could not start $label; run enable-agent.sh as $user"
exit 0
